{
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/admin/team-user-access", "destination": "/api/admin/team-users" }
  ]
}
