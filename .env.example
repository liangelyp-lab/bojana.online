# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Drive integration. Server-only credentials: never add VITE_ to secret names.
# Development: set APP_URL above to http://localhost:3000.
# Production: set APP_URL to the HTTPS origin serving both the portal and /api/storage.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: enables Google Picker for files outside the managed project folder.
GOOGLE_PICKER_API_KEY=""
GOOGLE_CLOUD_PROJECT_NUMBER=""
# 64 hex characters; generate with: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=""
# Salted scrypt hash generated as described in docs/STORAGE_ARCHITECTURE.md
STUDIO_PASSWORD_HASH=""
# Persistent local disk. Must not be ephemeral in production.
STORAGE_DB_PATH=".data/storage.sqlite"
STORAGE_MAX_UPLOAD_MB="50"
API_PORT="3001"
