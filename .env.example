VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side Supabase access (required by /api routes; never expose the service key in the browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Drive storage (optional until Drive uploads are enabled)
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=https://YOUR_DOMAIN/api/storage/oauth/callback
DRIVE_STUDIO_PASSWORD=YOUR_STUDIO_DRIVE_PASSWORD
DRIVE_SESSION_SECRET=YOUR_LONG_RANDOM_SESSION_SECRET
GOOGLE_DRIVE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_DRIVE_APP_ID=YOUR_GOOGLE_CLOUD_PROJECT_NUMBER
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Bojana Estudio
DRIVE_MAX_UPLOAD_BYTES=52428800

# Direct portal links
DIRECT_LINK_SECRET=YOUR_LONG_RANDOM_DIRECT_LINK_SECRET
APP_URL=https://YOUR_DOMAIN

# SMTP / IMAP inbox (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_USER=info@example.com
MAIL_PASSWORD=YOUR_MAIL_PASSWORD

# Lark login (optional)
LARK_APP_ID=YOUR_LARK_APP_ID
LARK_APP_SECRET=YOUR_LARK_APP_SECRET
LARK_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/lark/callback
# Optional allow-list restrictions:
# LARK_ALLOWED_OPEN_ID=YOUR_OPEN_ID
# LARK_ALLOWED_EMAIL=you@example.com
